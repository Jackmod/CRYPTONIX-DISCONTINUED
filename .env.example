# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cryptonix

# --- Helius ---
HELIUS_API_KEY=your-helius-api-key-here

# Must be a PUBLIC https URL Helius can POST to. Pointed at localhost, every
# /track fails with "Invalid webhook URL format" — run `ngrok http 8787` and
# use the https URL it prints. The engine warns at startup if this is
# unreachable from the internet.
WEBHOOK_BASE_URL=http://localhost:8787

# Any random string. Helius echoes it back as the Authorization header on
# every delivery, so forged trades can be rejected before they touch the
# database. WEBHOOK_BASE_URL is public by design, so this is what protects it.
WEBHOOK_SECRET=change-me-to-a-random-value

PORT=8787

# --- Engine API ---
# Guards every engine route except /webhooks/helius, and the alert WebSocket.
# The engine has to be publicly reachable for Helius, so without this anyone
# who finds the host can read your wallets, delete trade history, or repoint a
# server's alerts. Generate with: openssl rand -hex 32
ENGINE_API_KEY=generate-with-openssl-rand-hex-32

# --- Discord bot ---
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_CLIENT_ID=your-discord-application-id

# Optional. Commands register globally so the bot works in any server; setting
# this ALSO registers them to one guild, where Discord makes them available
# instantly rather than after global propagation. Alert routing is per-server
# via /setup, never from env.
DISCORD_GUILD_ID=your-dev-server-id

# Where the bot finds the engine. ENGINE_API_KEY above must match.
ENGINE_HTTP_URL=http://localhost:8787
ENGINE_WS_URL=ws://localhost:8787/ws

# --- Test databases ---
# One per package: turbo runs their test tasks in parallel and every suite
# truncates the same table names, so sharing one lets them delete each other's
# rows mid-test. Create all three and push the schema to each (see README).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cryptonix_test
TEST_DATABASE_URL_DB=postgres://postgres:postgres@localhost:5432/cryptonix_test_db
TEST_DATABASE_URL_E2E=postgres://postgres:postgres@localhost:5432/cryptonix_test_e2e

# --- New-coin scanner (Phase 3) ---
# Off unless explicitly enabled. Uses DexScreener's public API: no account, no
# key, no cost (see docs/superpowers/specs/2026-09-01-phase-3-data-sources-spike.md).
COIN_SCANNER_ENABLED=false
COIN_SCANNER_INTERVAL_MS=60000

# Momentum gates. Every one is optional -- leave it unset to use the documented
# default. Spec §12 expects these tuned against real traffic after launch, so
# tuning must never need a code change. Defaults shown in comments.
# COIN_MAX_AGE_MINUTES=60
# COIN_MIN_VOLUME_5M=5000
# COIN_MIN_BUY_RATIO=0.6
# COIN_MIN_PRICE_CHANGE_5M=20
# COIN_MIN_TRADES_5M=30
# COIN_MIN_LIQUIDITY_USD=5000

# --- Twitter / X monitoring (Phase 3) ---
# Off unless a key is set. Discovery -- finding out that a tracked handle has
# posted -- is the only part of Cryptonix that cannot be done for free: X's
# free API tier is write-only, and Nitter was served cease-and-desist letters
# on 2026-08-24 and archived. Rendering a tweet stays free regardless, through
# X's own embed CDN, so the Calls tab and the Discord embed work without this.
#
# TwitterAPI.io: $0.15 per 1,000 tweets returned, $1 trial credit, no card.
# https://twitterapi.io
TWITTER_API_KEY=

# How often to check every tracked handle. Minimum 30s, default 2 minutes.
#
# This matters for cost, not just load: the provider charges a floor fee PER
# CALL whether or not a tweet comes back. Polling 20 handles every minute is
# roughly $130/month; every two minutes is half that, and the tweets
# themselves cost under a dollar. For more than a handful of handles, move to
# their webhook filter rules instead -- they push, so nothing is billed for
# silence.
TWEET_POLL_INTERVAL_MS=120000
